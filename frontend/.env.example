# Frontend environment variables for MediVision AI
# Copy to frontend/.env.local — Vite reads .env.local automatically.
# Never commit .env.local to version control.

# Supabase Project URL — Project Settings → API → Project URL
VITE_SUPABASE_URL=https://yourproject.supabase.co

# Supabase anon/public key — Project Settings → API → anon public key
# This key is safe to expose in the browser.
VITE_SUPABASE_ANON_KEY=your_anon_key_here
