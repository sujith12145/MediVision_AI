# Environment variables for MediVision AI — Backend
# Copy this file to .env and fill in the real values.
# Never commit .env to version control.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API → Project URL
SUPABASE_URL=https://yourproject.supabase.co

# Project Settings → API → anon public key (safe for frontend use)
SUPABASE_ANON_KEY=your_anon_key_here

# Project Settings → API → service_role key (SERVER-SIDE ONLY — never expose to browser)
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Name of the Supabase Storage bucket for uploaded images
SUPABASE_STORAGE_BUCKET=medicine-images

# ─── Database ────────────────────────────────────────────────────────────────
# Supabase PostgreSQL — Project Settings → Database → Connection string
# Use the Transaction Pooler (port 6543) for best compatibility
DATABASE_URL=postgresql://postgres.yourproject:password@aws-0-region.pooler.supabase.com:6543/postgres

# ─── Vision / AI Keys ────────────────────────────────────────────────────────
# Gemini Vision API key (https://aistudio.google.com/app/apikey)
VISION_API_KEY=your_gemini_api_key_here

# Gemini model to use (flash = fast+cheap, pro = higher accuracy)
VISION_MODEL=gemini-1.5-flash

# LLM API key — reserved for a separate text-only model if added later
LLM_API_KEY=your_llm_api_key_here

# ─── Auth (legacy — no longer used for token generation) ─────────────────────
# Supabase Auth is now the token issuer. JWT_SECRET is kept for backward compat.
JWT_SECRET=not_used_supabase_issues_tokens_now
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Upload constraints ───────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=5
UPLOAD_RATE_LIMIT=20/minute

# ─── App Settings ─────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
